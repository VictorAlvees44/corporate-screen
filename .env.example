# Copie para .env somente no desenvolvimento local. Nunca versione .env.
NODE_ENV=development
LISTEN_HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Crie credenciais próprias. Os valores abaixo ficam intencionalmente vazios.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=
